{
    "extends": "stylelint-config-standard",
    "ignoreFiles": ["src/main/themes/*.theme.css", "src/kittycordplugins/helloKittyTheme/style.css"],
    "rules": {
        "declaration-block-no-duplicate-properties": [
            true,
            {
                "ignore": ["consecutive-duplicates-with-different-syntaxes"]
            }
        ],
        "property-no-vendor-prefix": [
            true,
            {
                "ignoreProperties": ["backdrop-filter", "/backdrop-filter/"]
            }
        ],
        "selector-class-pattern": [
            "^[a-z][a-zA-Z0-9]*(-[a-z0-9][a-zA-Z0-9]*)*$",
            {
                "message": "Expected class selector to be kebab-case with camelCase segments"
            }
        ]
    }
}
